FROM python:3.13-slim

WORKDIR /app

COPY scripts/screener_requirements.txt ./
RUN pip install --no-cache-dir -r screener_requirements.txt

# price_history leest Nasdaq (via quotes._nasdaq_get) en Boerse Frankfurt (via
# quotes._http_get_json) en schrijft naar Supabase price_history;
# earnings_history leest Nasdaq earnings-surprise en schrijft naar
# earnings_history. gather_data levert de gedeelde SSL-context/HTTP-helper.
COPY gather_data.py quotes.py price_history.py earnings_history.py /app/
COPY scripts/run_price_history.py /app/scripts/

CMD ["python", "scripts/run_price_history.py"]
